<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>موقع الكنروني</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  }

  body {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 30px 20px;
    color: #fff;
  }

  /* الهيدر */
  header {
    width: 100%;
    max-width: 900px;
    text-align: center;
    padding: 25px 20px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    margin-bottom: 30px;
    animation: fadeDown 0.8s ease;
  }

  header h1 {
    font-size: 2.2rem;
    background: linear-gradient(90deg, #00f2fe, #4facfe, #f093fb);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 1px;
  }

  header p {
    margin-top: 8px;
    color: #b8b8d0;
    font-size: 1rem;
  }

  /* شبكة الأقسام */
  .sections {
    width: 100%;
    max-width: 900px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .card {
    position: relative;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 20px;
    padding: 35px 20px;
    text-align: center;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    animation: fadeUp 0.8s ease backwards;
  }

  .card:nth-child(1) { animation-delay: 0.1s; }
  .card:nth-child(2) { animation-delay: 0.2s; }
  .card:nth-child(3) { animation-delay: 0.3s; }
  .card:nth-child(4) { animation-delay: 0.4s; }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(79,172,254,0.25), rgba(240,147,251,0.15));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .card:hover::before { opacity: 1; }

  .card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(79,172,254,0.7);
    box-shadow: 0 15px 40px rgba(79,172,254,0.35);
  }

  .card .num {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    font-size: 2rem;
    font-weight: bold;
    color: #fff;
    background: linear-gradient(135deg, #4facfe, #00f2fe);
    box-shadow: 0 0 25px rgba(79,172,254,0.7);
    margin-bottom: 15px;
    transition: transform 0.4s ease;
  }

  .card:hover .num { transform: rotate(360deg) scale(1.1); }

  .card h2 {
    position: relative;
    z-index: 1;
    font-size: 1.4rem;
    margin-bottom: 6px;
    color: #e8e8ff;
  }

  .card p {
    position: relative;
    z-index: 1;
    font-size: 0.9rem;
    color: #a8a8c8;
  }

  /* الفوتر */
  footer {
    width: 100%;
    max-width: 900px;
    margin-top: 35px;
    padding: 25px 20px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    text-align: center;
    animation: fadeUp 0.8s ease 0.5s backwards;
  }

  footer .rights {
    font-size: 1.05rem;
    color: #d0d0f0;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  footer .rights .icon {
    color: #f093fb;
  }

  footer .name {
    font-size: 1.3rem;
    font-weight: bold;
    background: linear-gradient(90deg, #00f2fe, #4facfe, #f093fb);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 1px;
    padding: 10px 25px;
    border: 1px dashed rgba(79,172,254,0.6);
    border-radius: 12px;
    display: inline-block;
    margin-top: 5px;
  }

  .divider {
    width: 70%;
    max-width: 500px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(79,172,254,0.7), transparent);
    margin: 15px auto;
  }

  /* الحركات */
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* الجوال */
  @media (max-width: 600px) {
    .sections { grid-template-columns: 1fr; }
    header h1 { font-size: 1.6rem; }
    .card { padding: 28px 15px; }
    footer .rights { font-size: 0.95rem; }
    footer .name { font-size: 1.1rem; }
  }
</style>
</head>
<body>

  <!-- الهيدر -->
  <header>
    <h1>موقع الكنروني</h1>
    <p>مرحباً بك في الموقع المتكامل ✨</p>
  </header>

  <!-- الأقسام الأربعة -->
  <main class="sections">
    <div class="card">
      <div class="num">1</div>
      <h2>القسم الأول</h2>
      <p>محتوى القسم الأول</p>
    </div>

    <div class="card">
      <div class="num">2</div>
      <h2>القسم الثاني</h2>
      <p>محتوى القسم الثاني</p>
    </div>

    <div class="card">
      <div class="num">3</div>
      <h2>القسم الثالث</h2>
      <p>محتوى القسم الثالث</p>
    </div>

    <div class="card">
      <div class="num">4</div>
      <h2>القسم الرابع</h2>
      <p>محتوى القسم الرابع</p>
    </div>
  </main>

  <!-- الفوتر: الحقوق والاسم -->
  <footer>
    <div class="rights">
      <span class="icon">©</span>
      <span>جميع الحقوق محفوظة</span>
      <span>|</span>
      <span>2026</span>
    </div>
    <div class="divider"></div>
    <div class="name">الكنروني</div>
  </footer>

</body>
</html>
